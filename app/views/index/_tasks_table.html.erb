<div id="tasks-table" class="w-full max-w-40 mx-auto p-4 md:p-6">
  <%= turbo_stream_from project %>
  <div class="grid grid-cols-1 gap-4" data-controller="drag-and-drop">
    <% project.tasks.sort_by(&:position).each do |task| %>

      <%= render "index/task", task: %>
    <% end %>
  </div>
</div>
