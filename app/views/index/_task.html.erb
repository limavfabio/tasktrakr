<li
  id="<%= dom_id task %>"
  data-task-id="<%= task.id %>"
  data-controller="dialog"
>
  <%= turbo_stream_from task %>
  <div class="bg-white rounded-lg shadow-md dark:bg-gray-900 dark:text-gray-200">
    <div
      class="
        flex items-center justify-between px-4 py-3 border-b dark:border-gray-800
      "
    >
      <div class="flex items-center mr-10 space-x-2">
        <input
          type="checkbox"
          <%= task.completed? ? "checked" : "" %>
          name="completed?"
          data-task-id="<%= task.id %>"
          data-controller="task-checkbox"
          data-action="change->task-checkbox#toggleComplete"
          class="
            w-4 h-4 text-blue-600 bg-gray-100 rounded border-gray-300 focus:ring-blue-500
            dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700
            dark:border-gray-600
          "
        >
        <h3 class="font-medium"><%= task.title %></h3>
      </div>
      <div class="flex items-center space-x-4">
        <span class="text-sm text-gray-500 dark:text-gray-400"><%= task.due_date ? format_time(task.due_date) : "No due date" %></span>

        <sl-dropdown class="sortable-ignore">
          <sl-icon-button slot="trigger" name="three-dots" label="Settings"></sl-icon-button>

          <sl-menu>
            <sl-menu-item data-action="click->dialog#open">
              Edit Task
              <sl-icon slot="prefix" name="pencil"></sl-icon>
            </sl-menu-item>
            <sl-menu-item>
              <%= button_to "Destroy task",
              task,
              method: :delete,
              data: {
                confirm: "Are you sure you want to delete this task?",
              } %>
              <sl-icon slot="prefix" name="eraser"></sl-icon>
            </sl-menu-item>
          </sl-menu>
        </sl-dropdown>

      </div>
    </div>
    <div class="px-4 py-3 space-y-2">
      <p class="text-sm text-gray-500 dark:text-gray-400">
        <%= task.description.presence || "No description" %>
      </p>

    </div>
  </div>

  <%# Edit TaskDialog %>
  <sl-dialog
    class="sortable-ignore"
    data-dialog-target="dialog"
    label="Dialog"
    data-dialog-target="dialog-overview"
  >
    <div>
      <%= form_with model: task, class: "dark:text-gray-300" do |f| %>
        <div class="gap-4 flex flex-col">
          <%= f.label 'Task\'s title',
                  class: "dark:text-gray-300 block text-gray-700 text-sm font-bold mb-2" %>
          <%= f.text_field :title,
                       class:
                         "dark:bg-slate-800 w-full py-2 px-3 border rounded shadow appearance-none" %>
          <%= f.label 'Task\'s due date',
                  class: "dark:text-gray-300 block text-gray-700 text-sm font-bold mb-2" %>
          <%= f.text_field :due_date,
                       class:
                         "dark:bg-slate-800 w-full py-2 px-3 border rounded shadow appearance-none" %>
          <%= f.submit "Update Task",
                   class:
                     "bg-green-700 text-white px-5 py-3 rounded hover:bg-green-600 shadow" %>
        </div>
      <% end %>
    </div>

    <sl-button data-action="click->dialog#close" slot="footer" variant="primary">Close</sl-button>
  </sl-dialog>
</li>
