<div class="bg-white rounded-lg shadow-md dark:bg-gray-900 dark:text-gray-200">
  <div
    class="
      flex items-center justify-between px-4 py-3 border-b dark:border-gray-800
    "
  >
    <div class="flex items-center mr-10 space-x-2">
      <div class="w-3 h-3 rounded-full bg-green-500"></div>
      <h3 class="font-medium"><%= task.title %></h3>
    </div>
    <div class="flex items-center space-x-4">
      <span class="text-sm text-gray-500 dark:text-gray-400"><%= task.due_date ? format_time(task.due_date) : "No due date" %></span>
      <%= render DropdownComponent.new do %>
        <%= render DropdownButtonComponent.new do %>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-5 h-5"
          >
            <polyline points="18 8 22 12 18 16"></polyline>
            <polyline points="6 8 2 12 6 16"></polyline>
            <line x1="2" x2="22" y1="12" y2="12"></line>
          </svg>
        <% end %>
        <%= render DropdownMenuComponent.new do %>
          <li>
            <%= link_to "Edit task",
            edit_task_path(task),
            class: "block px-4 py-2 hover:bg-gray-100" %>
          </li>
          <li>
            <%= button_to "Destroy task",
            task,
            method: :delete,
            data: {
              confirm: "Are you sure you want to delete this task?",
            },
            class: "block px-4 py-2 hover:bg-gray-100" %>
          </li>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="px-4 py-3 space-y-2">
    <p class="text-sm text-gray-500 dark:text-gray-400">
      <%= task.description.presence || "No description" %>
    </p>

  </div>
</div>
