<div class="flex h-screen w-full">
  <div class="dark:bg-slate-800 bg-gray-100 p-4 ">
    <div class="mb-5"><%= render "index/project", project: @inbox %></div>

    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold">Projects</h2>

      <sl-dropdown>
        <sl-button slot="trigger" caret>Add Project</sl-button>
        <sl-menu>
          <%= form_with model: Project.new, class: "px-4" do |form| %>
            <div class="mb-4">
              <%= form.label 'Project\'s name',
                         class:
                           "block text-gray-700 text-sm font-bold mb-2 dark:text-gray-300" %>
              <%= form.text_field :name,
                              class:
                                "w-full py-2 px-3 border rounded shadow appearance-none dark:text-gray-300 dark:bg-slate-800" %>
            </div>

            <div class="mb-4">
              <%= form.submit "Save",
                          class:
                            "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
            </div>
          <% end %>
        </sl-menu>
      </sl-dropdown>
    </div>
    <div class="space-y-2">
      <% @projects.each do |project| %>
        <%= render "index/project", project: %>
      <% end %>
    </div>
  </div>
  <div class="p-6">
    <div class="flex items-center justify-between mb-6">
      <div class="flex gap-3">
        <h1 class="text-2xl font-bold"><%= @project.name %></h1>

        <% unless @project.inbox? %>
          <%= render DropdownComponent.new do %>
            <%= render DropdownButtonComponent.new do %>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="h-6 mt-1"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z"
                />
              </svg>
            <% end %>

            <%= render DropdownMenuComponent.new do %>
              <%= render DropdownMenuItemComponent.new do %>
                Edit project
              <% end %>

              <%= button_to "Delete Project",
              project_path(@project),
              method: :delete,
              class: "block px-4 py-2 hover:bg-gray-100" %>

              <%= render DialogComponent.new open_button: "Add Colaborator", close_button: "Cancel" do %>
                <%= form_with url: add_collaborator_project_path(@project) do |f| %>

                  <%= f.label :email, class: "block text-gray-700 text-sm font-bold mb-2" %>

                  <%= f.text_field :email,
                               placeholder: "john.doe@example.com",
                               class:
                                 "w-full py-2 px-3 mb-4 border rounded shadow appearance-none" %>

                  <%= f.submit "Add Collaborator",
                           class:
                             "bg-green-700 text-white px-5 py-3 rounded hover:bg-green-600 shadow" %>
                <% end %>
              <% end %>

            <% end %>
          <% end %>
        <% end %>
      </div>

      <div class="flex items-center gap-2">
        <sl-dropdown>
          <sl-button slot="trigger" caret>Add Task</sl-button>
          <sl-menu>
            <%= form_with model: [@project, Task.new], class: "px-4" do |form| %>
              <div class="mb-4">
                <%= form.label 'Task\'s title',
                           class:
                             "block text-gray-700 text-sm font-bold mb-2 dark:text-gray-300" %>
                <%= form.text_field :title,
                                class:
                                  "w-full py-2 px-3 border rounded shadow appearance-none dark:text-gray-300 dark:bg-slate-800" %>
              </div>

                <%= form.submit "Save",
                            class:
                              "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
            <% end %>
          </sl-menu>
        </sl-dropdown>
      </div>
    </div>
    <!-- Tasks table -->
    <%= render "index/tasks_table", project: @project %>
  </div>
</div>
